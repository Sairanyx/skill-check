# Copy to .env.local and fill in. Never commit .env.local (it is git-ignored).

# Postgres on Aiven (Finland). Aiven console → service → Service URI
DATABASE_URL=postgres://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require

# Login (Better Auth). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100

# Self-hosted models on the Verda server (Finland).
# Local dev: open an SSH tunnel first (see infra/README.md), then these point at localhost.
VLLM_API_KEY=
GUARD_BASE_URL=http://127.0.0.1:8001/v1
GUARD_MODEL=gemma
ASR_BASE_URL=http://127.0.0.1:8003/v1
ASR_MODEL=whisper

# Models. Every provider uses the same OpenAI-compatible API (see src/lib/ai/llm.ts).
# Interviewer: gemma (default) or gemini. Judges: a panel from different companies, e.g. gemma,mistral,gemini
INTERVIEWER=gemma
JUDGES=gemma
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Mistral judge on the second Verda server (see infra/judge/). Local dev: through ./infra/tunnel.sh
MISTRAL_BASE_URL=http://127.0.0.1:8004/v1
MISTRAL_API_KEY=

# Interview panel service (panel/, docs/PANEL_API.md). Both set = the panel runs the interview;
# leave empty to use the built-in interviewer. Local: http://127.0.0.1:8010, server: http://panel:8010
PANEL_URL=
PANEL_API_KEY=

# Optional partner APIs
CONTEXT_DEV_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Demo seed password (default: junction2026)
SEED_PASSWORD=
