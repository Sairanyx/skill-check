# Copy to panel/.env for local runs. Never commit .env.

# Postgres. Can be the platform's own database (Aiven, Finland): the panel only
# creates and uses one table, panel_interview.
DATABASE_URL=postgres://postgres@localhost:5432/skillcheck_panel

# Gemini API key (Google AI Studio). Free keys only with synthetic demo data.
GEMINI_API_KEY=

# Shared secret the platform's server sends as "Authorization: Bearer ...".
# At least 16 characters. Generate with: openssl rand -hex 24
PANEL_API_KEY=

# Where to listen. Keep it on localhost or the private Docker network.
PANEL_ADDR=127.0.0.1:8010
