{
  "name": "skill-check",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env.local --conditions=react-server src/db/seed.ts",
    "db:audit": "tsx --env-file=.env.local src/db/apply-sql.ts",
    "db:reset": "tsx --env-file=.env.local src/db/reset.ts",
    "db:demo": "tsx --env-file=.env.local --conditions=react-server src/db/seed-demo.ts",
    "db:fresh": "npm run db:reset -- --yes && npm run db:seed && npm run db:demo",
    "bench:panel": "tsx --conditions=react-server --env-file=.env.local src/db/bench-panel.ts",
    "demo:now": "tsx --conditions=react-server --env-file=.env.local src/db/demo-now.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "better-auth": "^1.7.23",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
